# ===== 基础 =====
# 调试模式（生产建议 False）
DEBUG=true
# 数据库：开发默认 SQLite；生产可改为 postgresql+psycopg2://user:pass@localhost/kb
DATABASE_URL=sqlite:///./data/kb.db
# 数据目录（文档原件、向量/图谱本地回退持久化）
DATA_DIR=data
# JWT 密钥（生产必须改为随机长字符串）
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_EXPIRE_MINUTES=720

# ===== 管理员初始账号（首次启动自动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== Embedding（默认云端 OpenAI 兼容）=====
# 模式: openai（云端兼容 API）| dummy（离线开发占位，无网络时用）
EMBEDDING_MODE=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=16

# ===== 云端大模型（OpenAI 兼容，用于图谱抽取与聚合生成）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# ===== 向量库 =====
# 后端: local（开发/单机回退）| qdrant
VECTOR_BACKEND=local
QDRANT_URL=http://localhost:6333

# ===== 图数据库 =====
# 后端: local（开发/单机回退）| neo4j
GRAPH_BACKEND=local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# ===== 流水线默认参数 =====
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64
GRAPH_EXTRACTION_ENABLED=true
GRAPH_BATCH_CHUNKS=8

# ===== MCP Server（Streamable HTTP，供 Claude/Cursor/Dify 等调用）=====
MCP_ENABLED=true
